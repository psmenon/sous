# Required. Server only. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional model overrides
MODEL_ADAPT=claude-sonnet-5-5
MODEL_ASK=claude-haiku-4-5-20251001

# Password for /admin. If empty, /admin is disabled.
ADMIN_PASSWORD=

# Postgres connection string (Neon, Supabase or any Postgres).
# If empty, sessions are saved to .data/sessions.json (local runs only).
DATABASE_URL=

# Optional secret used to sign the admin cookie. Defaults to a hash of ADMIN_PASSWORD.
ADMIN_COOKIE_SECRET=

# LOCAL TESTING ONLY. Leave empty and never set it on Vercel.
# "1" compiles in canned answers so you can click through without an API key.
# "invalid" simulates a broken answer so the error states can be checked.
# It is read at build time: rebuild after changing it.
SOUS_FAKE_AI=
